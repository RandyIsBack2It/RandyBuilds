---
// The vault (/preview/): where a prospect or client enters their private code to
// open the website concept prepared for them. Posts to the gate container
// (gate/server.mjs), which checks the code server-side. Nothing here lists or
// hints at which previews exist.
import Base from '../layouts/Base.astro';
import { site, mailto } from '../site';

interface Props { state?: 'locked' | 'denied' | 'sealed' }
const { state = 'locked' } = Astro.props;
const status = {
  locked: 'vault locked · awaiting code',
  denied: 'access denied · code not recognized',
  sealed: 'vault sealed · too many attempts',
}[state];
const error = state === 'denied' ? 'That code didn’t match a preview. Check it and try again.'
  : state === 'sealed' ? 'Too many attempts. Wait 15 minutes, then try again.' : '';
const ticks = Array.from({ length: 60 }, (_, i) => i);
---
<Base title="Your website preview" description="Enter your private preview code to view a website concept prepared for your business." noindex cta={false}>
  <div class="wrap vault-page">
    <div class="vault-intro">
      <p class="kicker"><b>~</b> preview / vault</p>
      <h1 id="access-title">Your website preview</h1>
      <p class="section__lede">Enter your private preview code to view a website concept prepared for your business.</p>
      <ul class="vault-notes">
        <li>Each code opens one private preview.</li>
        <li>Previews aren’t listed or indexed anywhere.</li>
        <li>Lost your code? Email <a href={mailto('Preview code')}>{site.contact.email}</a>.</li>
      </ul>
    </div>

    <section class={`vault vault--${state}`} aria-labelledby="access-title">
      <div class="vault__bar" aria-hidden="true"><span>client_vault</span><span class="vault__id">RBT-SECURE</span></div>
      <div class="vault__door">
        <svg class="vault__dial" viewBox="0 0 200 200" aria-hidden="true" data-dial>
          <circle class="vault__ring" cx="100" cy="100" r="92" />
          <circle class="vault__ring vault__ring--inner" cx="100" cy="100" r="74" />
          <g class="vault__ticks">
            {ticks.map((i) => <line x1="100" y1={i % 5 === 0 ? 10 : 14} x2="100" y2="20" transform={`rotate(${i * 6} 100 100)`} class={i % 5 === 0 ? 'major' : ''} />)}
          </g>
          <g class="vault__wheel">
            {[0, 60, 120, 180, 240, 300].map((a) => <line x1="100" y1="100" x2="100" y2="40" transform={`rotate(${a} 100 100)`} />)}
            {[0, 60, 120, 180, 240, 300].map((a) => <circle cx="100" cy="36" r="6" transform={`rotate(${a} 100 100)`} />)}
            <circle class="vault__hub" cx="100" cy="100" r="18" />
            <circle class="vault__hub-dot" cx="100" cy="100" r="5" />
          </g>
          <path class="vault__marker" d="M100 2 l6 9 h-12 z" />
        </svg>
        <p class="vault__status" role={state === 'locked' ? undefined : 'status'}><span class="vault__led" aria-hidden="true"></span>{status}</p>
      </div>

      <form class="vault__form" method="post" action="/api/preview/login" data-vault-form>
        {error && <p class="field__error vault__error" id="code-error" role="alert">{error}</p>}
        <div class="field">
          <label for="code">Preview code</label>
          <input id="code" name="code" required maxlength="64" autocomplete="off" autocapitalize="characters" spellcheck="false"
            placeholder="your code"
            aria-describedby={error ? 'code-hint code-error' : 'code-hint'} aria-invalid={error ? 'true' : undefined} autofocus={!!error} />
          <p class="field__hint" id="code-hint">Not case-sensitive. Spaces and dashes don’t matter.</p>
        </div>
        <button class="btn btn--orange vault__btn" type="submit">View preview</button>
      </form>
    </section>
  </div>

  <div class="unlock" data-unlock hidden>
    <div class="unlock__light" aria-hidden="true"></div>
    <div class="unlock__door unlock__door--l" aria-hidden="true"><span>client_vault</span></div>
    <div class="unlock__door unlock__door--r" aria-hidden="true"><span>RBT-SECURE</span></div>
    <span class="unlock__seam" aria-hidden="true"></span>
    <span class="unlock__bolt unlock__bolt--top" aria-hidden="true"></span>
    <span class="unlock__bolt unlock__bolt--bottom" aria-hidden="true"></span>
    <div class="unlock__core">
      <svg class="unlock__dial" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="vault__ring" cx="100" cy="100" r="92" />
        <circle class="unlock__progress" cx="100" cy="100" r="92" transform="rotate(-90 100 100)" />
        <circle class="vault__ring vault__ring--inner" cx="100" cy="100" r="74" />
        <g class="vault__ticks">
          {ticks.map((i) => <line x1="100" y1={i % 5 === 0 ? 10 : 14} x2="100" y2="20" transform={`rotate(${i * 6} 100 100)`} class={i % 5 === 0 ? 'major' : ''} />)}
        </g>
        <g class="vault__wheel">
          {[0, 60, 120, 180, 240, 300].map((a) => <line x1="100" y1="100" x2="100" y2="40" transform={`rotate(${a} 100 100)`} />)}
          {[0, 60, 120, 180, 240, 300].map((a) => <circle cx="100" cy="36" r="6" transform={`rotate(${a} 100 100)`} />)}
          <circle class="vault__hub" cx="100" cy="100" r="18" />
          <circle class="vault__hub-dot" cx="100" cy="100" r="5" />
        </g>
        <path class="vault__marker" d="M100 2 l6 9 h-12 z" />
      </svg>
      <p class="vault__status unlock__status" role="status"><span class="vault__led" aria-hidden="true"></span><span data-unlock-text>verifying code</span></p>
    </div>
  </div>

  <script>
    // Check the code without leaving the page. A wrong code goes to the usual
    // try-again page; a right one plays the full-screen unlock, then opens the
    // preview. Without JavaScript (or on any error) the form posts normally.
    const form = document.querySelector<HTMLFormElement>('[data-vault-form]');
    const unlock = document.querySelector<HTMLElement>('[data-unlock]');
    const text = document.querySelector<HTMLElement>('[data-unlock-text]');
    const vault = document.querySelector('.vault');
    const btn = form?.querySelector<HTMLButtonElement>('button[type=submit]');
    const input = form?.querySelector<HTMLInputElement>('#code');
    const DENIED = /^\/preview\/(try-again\/|too-many-attempts\/)?$/;
    let timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

    function play(href: string) {
      if (!unlock || !text) return location.assign(href);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      unlock.hidden = false;
      void unlock.offsetWidth;   // start the fade-in from opacity 0
      unlock.classList.add('is-on');
      if (reduce) {
        at(250, () => { text.textContent = 'access granted · opening'; unlock.classList.add('is-granted'); });
        at(900, () => location.assign(href));
        return;
      }
      at(1050, () => { text.textContent = 'access granted'; unlock.classList.add('is-granted'); });
      at(1300, () => unlock.classList.add('is-open'));
      at(1950, () => unlock.classList.add('is-leaving'));
      at(2200, () => location.assign(href));
    }

    form?.addEventListener('submit', async (e) => {
      if (!form.checkValidity() || !input) return;
      e.preventDefault();
      vault?.classList.add('is-unlocking');
      if (btn) { btn.textContent = 'Checking…'; btn.disabled = true; }
      let res: Response;
      try {
        res = await fetch(form.action, { method: 'POST', body: new URLSearchParams({ code: input.value }), credentials: 'same-origin' });
      } catch { return form.submit(); }
      if (!res.redirected) return form.submit();   // e.g. nginx rate limit: show its answer as before
      const to = new URL(res.url);
      if (DENIED.test(to.pathname)) return location.assign(to.href);
      play(to.href);
    });

    // Back button from the preview: show the form again, not the finished animation.
    addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      timers.forEach(clearTimeout); timers = [];
      unlock?.classList.remove('is-on', 'is-granted', 'is-open', 'is-leaving');
      if (unlock) unlock.hidden = true;
      vault?.classList.remove('is-unlocking');
      if (btn) { btn.textContent = 'View preview'; btn.disabled = false; }
    });
  </script>
</Base>
<style>
  .vault-page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: clamp(2rem, 1rem + 5vw, 6rem); align-items: center; padding-block: clamp(3rem, 2rem + 5vw, 7rem); }
  .vault-intro { display: grid; gap: 1.1rem; align-content: start; }
  .vault-intro h1 { font-size: var(--step-4); letter-spacing: -0.04em; line-height: 0.98; }
  .vault-notes { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.55rem; color: var(--text-soft); font-size: 1rem; }
  .vault-notes li { position: relative; padding-left: 1.3rem; }
  .vault-notes li::before { content: '›'; position: absolute; left: 0; font-family: var(--mono); color: var(--cobalt-hi); }

  .vault { position: relative; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(180deg, var(--surface-2), var(--bg-2));
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.95), inset 0 0 0 1px rgba(110, 160, 255, 0.05); }
  .vault::after { content: ''; position: absolute; inset: 10px; border: 1px dashed rgba(110, 160, 255, 0.16); border-radius: 12px; pointer-events: none; }
  .vault__bar { display: flex; justify-content: space-between; padding: 0.6rem 1rem 0.6rem 3.4rem; border-bottom: 1px solid var(--line); font: 500 0.75rem/1 var(--mono); color: var(--text-soft);
    background: radial-gradient(circle at 1rem 50%, var(--orange) 4px, transparent 4.5px), radial-gradient(circle at 1.75rem 50%, var(--yellow) 4px, transparent 4.5px), radial-gradient(circle at 2.5rem 50%, var(--sea) 4px, transparent 4.5px), rgba(7, 17, 28, 0.6); }
  .vault__id { letter-spacing: 0.12em; }
  .vault__door { display: grid; justify-items: center; gap: 0.9rem; padding: 1.75rem 1.5rem 0.5rem; }
  .vault__dial { width: min(13rem, 62vw); height: auto; overflow: visible; }
  .vault__ring { fill: rgba(7, 17, 28, 0.55); stroke: var(--cobalt-hi); stroke-width: 1.5; }
  .vault__ring--inner { fill: rgba(29, 85, 196, 0.08); stroke: var(--line); stroke-dasharray: 3 5; }
  .vault__ticks line { stroke: var(--text-soft); stroke-width: 1; opacity: 0.55; }
  .vault__ticks line.major { stroke: var(--cobalt-hi); stroke-width: 2; opacity: 1; }
  .vault__wheel { transform-origin: 100px 100px; transition: transform 1.2s var(--ease); }
  .vault__wheel line { stroke: var(--cobalt-hi); stroke-width: 4; stroke-linecap: round; }
  .vault__wheel circle { fill: var(--bg); stroke: var(--cobalt-hi); stroke-width: 2.5; }
  .vault__hub { fill: var(--surface-2) !important; }
  .vault__hub-dot { fill: var(--orange) !important; stroke: none !important; }
  .vault__marker { fill: var(--orange); }
  .vault__status { display: inline-flex; align-items: center; gap: 0.6rem; margin: 0; padding: 0.4rem 0.85rem; border: 1px solid var(--line); border-radius: 999px; background: rgba(7, 17, 28, 0.7); font: 500 0.8rem/1.2 var(--mono); color: var(--text-soft); }
  .vault__led { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--orange); box-shadow: 0 0 10px var(--orange); animation: vault-blink 2.4s ease-in-out infinite; }
  .vault--denied .vault__led, .vault--sealed .vault__led { background: var(--danger); box-shadow: 0 0 12px var(--danger); }
  .vault--denied .vault__status, .vault--sealed .vault__status { color: var(--danger); border-color: rgba(255, 138, 128, 0.45); }
  .vault--denied .vault__ring { stroke: var(--danger); }
  .vault--sealed .vault__ring { stroke: var(--danger); stroke-dasharray: 2 4; }
  .vault--denied .vault__wheel { animation: vault-shake 0.5s var(--ease) 1; }
  .vault.is-unlocking .vault__wheel { transform: rotate(240deg); }
  .vault.is-unlocking .vault__led { background: var(--sea); box-shadow: 0 0 12px var(--sea); }
  .vault__form { position: relative; z-index: 1; display: grid; gap: 1.1rem; padding: 1.25rem 1.75rem 1.9rem; }
  .vault__error { margin: 0; }
  .vault input { min-height: 3.4rem; text-align: center; font: 600 1.25rem/1 var(--mono); letter-spacing: 0.18em; text-transform: uppercase; background: rgba(7, 17, 28, 0.85); }
  .vault input::placeholder { color: #4d6580; letter-spacing: 0.18em; }
  .vault .field__hint { text-align: center; font-size: 0.92rem; }
  .vault .field > label { text-align: center; font: 600 0.8rem/1.2 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-soft); }
  .vault__btn { width: 100%; justify-content: center; }

  /* Full-screen unlock after a right code: dial turns and the ring closes,
     bolts retract, the doors slide apart into light, then the light fades. */
  .unlock { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; overflow: hidden; background: var(--bg); opacity: 0; transition: opacity 0.35s var(--ease); }
  .unlock[hidden] { display: none; }
  .unlock.is-on { opacity: 1; }
  .unlock__light { position: absolute; inset: -25%; background: radial-gradient(closest-side, rgba(214, 232, 255, 0.95), rgba(110, 160, 255, 0.45) 35%, rgba(29, 85, 196, 0.14) 65%, transparent); opacity: 0; transform: scale(0.15); transition: transform 1s cubic-bezier(0.3, 0, 0.2, 1), opacity 0.5s var(--ease); }
  .unlock__door { position: absolute; top: 0; bottom: 0; width: 50%; display: flex; align-items: flex-end; padding: 1.5rem 2rem; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.14em; color: var(--text-soft);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(180deg, var(--surface-2), var(--bg-2));
    transition: transform 0.8s cubic-bezier(0.7, 0, 0.2, 1); }
  .unlock__door--l { left: 0; box-shadow: inset -1px 0 0 var(--cobalt-hi); }
  .unlock__door--r { right: 0; justify-content: flex-end; box-shadow: inset 1px 0 0 var(--cobalt-hi); }
  .unlock__seam { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: linear-gradient(transparent, var(--sea) 30%, var(--sea) 70%, transparent); box-shadow: 0 0 18px 2px var(--sea); opacity: 0; transition: opacity 0.25s var(--ease); }
  .unlock__bolt { position: absolute; left: 50%; width: 6rem; height: 0.8rem; margin-left: -3rem; border-radius: 999px; background: var(--cobalt-hi); box-shadow: 0 0 14px rgba(110, 160, 255, 0.5); transition: transform 0.25s var(--ease), opacity 0.25s; }
  .unlock__bolt--top { top: 18%; }
  .unlock__bolt--bottom { bottom: 18%; }
  .unlock__core { position: relative; z-index: 1; display: grid; justify-items: center; gap: 1.5rem; transition: transform 0.85s cubic-bezier(0.6, 0, 0.3, 1), opacity 0.6s var(--ease); }
  .unlock.is-on .unlock__core { animation: unlock-in 0.5s var(--ease) both; }
  .unlock__dial { width: min(60vmin, 22rem); height: auto; overflow: visible; }
  .unlock__progress { fill: none; stroke: var(--sea); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 578.1; stroke-dashoffset: 578.1; filter: drop-shadow(0 0 6px var(--sea)); }
  .unlock.is-on .unlock__progress { animation: unlock-draw 0.9s cubic-bezier(0.5, 0, 0.3, 1) 0.15s forwards; }
  .unlock.is-on .vault__wheel { animation: unlock-spin 1s cubic-bezier(0.5, 0, 0.3, 1) 0.1s both; }
  .unlock__status { font-size: 0.9rem; }
  .unlock.is-granted .vault__led { background: var(--sea); box-shadow: 0 0 12px var(--sea); animation: none; }
  .unlock.is-granted .unlock__status { color: var(--text); border-color: var(--sea); }
  .unlock.is-granted .vault__hub-dot { fill: var(--sea) !important; }
  .unlock.is-granted .unlock__dial { animation: unlock-pulse 0.35s var(--ease); }
  .unlock.is-granted .unlock__seam { opacity: 1; }
  .unlock.is-granted .unlock__bolt { transform: scaleX(0); opacity: 0; }
  .unlock.is-open .unlock__door--l { transform: translateX(-102%); }
  .unlock.is-open .unlock__door--r { transform: translateX(102%); }
  .unlock.is-open .unlock__seam { opacity: 0; }
  .unlock.is-open .unlock__core { transform: scale(2.6); opacity: 0; }
  .unlock.is-open .unlock__light { opacity: 1; transform: scale(1.3); }
  .unlock.is-leaving .unlock__light { opacity: 0; transition: opacity 0.3s var(--ease); }
  @keyframes unlock-in { from { opacity: 0; transform: scale(0.8); } }
  @keyframes unlock-draw { to { stroke-dashoffset: 0; } }
  @keyframes unlock-spin { from { transform: rotate(0deg); } to { transform: rotate(420deg); } }
  @keyframes unlock-pulse { 50% { transform: scale(1.05); } }
  @keyframes vault-blink { 50% { opacity: 0.35; } }
  @keyframes vault-shake { 20% { transform: rotate(-8deg); } 40% { transform: rotate(7deg); } 60% { transform: rotate(-4deg); } 80% { transform: rotate(2deg); } }
  @media (max-width: 56rem) { .vault-page { grid-template-columns: minmax(0, 1fr); } .vault { max-width: 30rem; } }
  @media (prefers-reduced-motion: reduce) {
    .vault__led, .vault--denied .vault__wheel { animation: none; } .vault__wheel { transition: none; }
    .unlock.is-on .unlock__core, .unlock.is-on .vault__wheel, .unlock.is-granted .unlock__dial { animation: none; }
    .unlock.is-on .unlock__progress { animation: none; stroke-dashoffset: 0; }
    .unlock__bolt, .unlock__seam { transition: none; }
  }
</style>
