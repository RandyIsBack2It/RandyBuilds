---
// Hero figure: a blueprint wireframe of a small-business site and its phone
// view, with callouts. Three layers drift at different depths (parallax.ts).
// Callouts name only what every website project includes (CLAUDE.md).
// Decorative.
---
<div class="figure" aria-hidden="true">
  <svg class="figure__browser" viewBox="0 0 460 330" data-parallax="0.08" data-parallax-origin="page">
    <rect class="fill" x="1" y="1" width="458" height="328" rx="10" />
    <rect class="ln" x="1" y="1" width="458" height="328" rx="10" />
    <path class="ln" d="M1 30h458" />
    <circle class="ln" cx="18" cy="15.5" r="4.5" /><circle class="ln" cx="33" cy="15.5" r="4.5" /><circle class="ln" cx="48" cy="15.5" r="4.5" />
    <rect class="ln ln--soft" x="74" y="8" width="230" height="15" rx="7.5" />
    <rect class="hot" x="22" y="46" width="54" height="9" rx="2" />
    <path class="ln ln--soft" d="M300 50.5h26M338 50.5h26M376 50.5h26M414 50.5h24" />
    <rect class="ln" x="22" y="78" width="210" height="16" rx="2" />
    <rect class="ln" x="22" y="100" width="160" height="16" rx="2" />
    <path class="ln ln--soft" d="M22 132h200M22 143h184M22 154h150" />
    <rect class="hot" x="22" y="170" width="86" height="24" rx="4" />
    <rect class="ln ln--soft" x="116" y="170" width="70" height="24" rx="4" />
    <rect class="ln" x="258" y="74" width="180" height="124" rx="4" />
    <path class="ln ln--soft" d="M258 74l180 124M438 74L258 198" />
    <rect class="ln ln--soft" x="22" y="218" width="128" height="88" rx="4" />
    <rect class="ln ln--soft" x="166" y="218" width="128" height="88" rx="4" />
    <rect class="ln ln--soft" x="310" y="218" width="128" height="88" rx="4" />
  </svg>
  <svg class="figure__phone" viewBox="0 0 120 236" data-parallax="0.22" data-parallax-origin="page">
    <rect class="fill" x="1" y="1" width="118" height="234" rx="16" />
    <rect class="ln" x="1" y="1" width="118" height="234" rx="16" />
    <rect class="ln ln--soft" x="44" y="8" width="32" height="7" rx="3.5" />
    <rect class="hot" x="12" y="28" width="30" height="7" rx="2" />
    <rect class="ln" x="12" y="48" width="92" height="12" rx="2" />
    <rect class="ln" x="12" y="64" width="70" height="12" rx="2" />
    <path class="ln ln--soft" d="M12 88h92M12 97h84M12 106h70" />
    <rect class="hot" x="12" y="120" width="96" height="20" rx="4" />
    <rect class="ln ln--soft" x="12" y="150" width="96" height="70" rx="4" />
  </svg>
  <svg class="figure__notes" viewBox="0 0 500 400" data-parallax="0.15" data-parallax-origin="page">
    <text class="note-t" x="0" y="-10"><tspan class="note-k">fig.01</tspan> — your site, planned</text>
    <circle class="dot" cx="65" cy="198" r="3.5" /><path class="ln ln--soft" d="M65 198L24 358H0" />
    <text class="note-t" x="0" y="372">contact form</text>
    <circle class="dot" cx="476" cy="370" r="3.5" /><path class="ln ln--soft" d="M476 370L490 404H500" />
    <text class="note-t" x="500" y="418" text-anchor="end">mobile-friendly</text>
    <circle class="dot" cx="210" cy="30" r="3.5" /><path class="ln ln--soft" d="M210 30l40-34h60" />
    <text class="note-t" x="252" y="-10">basic SEO setup</text>
  </svg>
</div>
