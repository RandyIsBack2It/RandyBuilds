---
import Base from '../layouts/Base.astro';
---
<Base title="Message sent" description="Your message was sent." noindex>
  <div class="wrap">
    <header class="page-head page-head--tall">
      <h1>Message sent.</h1>
      <p class="section__lede">Thanks. I’ll reply to the email address you gave.</p>
      <p><a class="btn btn--ghost" href="/">Back to the home page</a></p>
    </header>
  </div>
</Base>
